# ---------------------------------------------------------------
# Preco de Banana - variaveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# ---------------------------------------------------------------

# String de conexao PostgreSQL.
# No Render: use a "Internal Database URL" do seu Postgres.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/precodebanana?schema=public"

# Segredo usado para assinar os cookies de sessao (JWT).
# Gere um valor forte com: openssl rand -base64 32
AUTH_SECRET=""

# URL publica do site - usada em canonical, sitemap e Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Credenciais do admin inicial.
#
# Sao lidas APENAS pelo script de seed (npm run db:seed), que grava
# o hash bcrypt no banco. A aplicacao em execucao nunca le estas
# variaveis para autenticar.
#
# Depois do primeiro deploy voce pode remover ADMIN_PASSWORD do
# painel do Render - o login continua funcionando normalmente.
# ---------------------------------------------------------------
ADMIN_EMAIL="admin@precodebanana.com.br"
ADMIN_PASSWORD=""
